# ═══════════════════════════════════════════════════════════════════════
#  SwiftCab — Environment Variables (demo-friendly)
# ═══════════════════════════════════════════════════════════════════════
#
#  Copy this to `.env.local` and fill in what you have. Anything blank
#  just disables that feature — the app keeps working in demo mode and
#  never crashes. Demo accounts always work out of the box:
#
#      admin@swiftcab.com  /  Password123!
#      maya@swiftcab.com   /  Password123!
#      daniel@swiftcab.com /  Password123!
#
#  For Vercel: paste each var in
#  Project → Settings → Environment Variables.
# ═══════════════════════════════════════════════════════════════════════


# ─── 🔑 MANDATORY — auth breaks on Vercel without this ─────────────────
# Sign + verify JWT session cookies. Must be a long random string.
# Generate one in your terminal:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# ⚠️  WITHOUT THIS ON VERCEL, LOGIN RUNS INTO A REDIRECT LOOP.
#     Set the same value in Production / Preview / Development so cookies
#     stay valid across all branches.
JWT_SECRET="change-me-to-a-long-random-string"

# Issuer claim baked into every JWT — any short string is fine.
JWT_ISSUER="swiftcab"


# ─── 🌐 Public app URL (used in email links + OAuth callbacks) ──────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"


# ─── 🗄️  Database (OPTIONAL — demo mode if unset) ─────────────────────
# Without this, signups live in an in-memory + /tmp JSON store. Demo
# accounts always work, but new signups don't persist across server
# restarts. Set this when you want real persistence.
#
# Local Postgres via Docker:
#   docker run -d --name swiftcab-pg -p 5432:5432 \
#     -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=swiftcab postgres:16
#
# Then run:
#   npx prisma migrate deploy
#   npx prisma db seed
DATABASE_URL=""


# ─── 💳 Stripe (OPTIONAL — payments mock when keys are blank) ──────────
# Test keys: https://dashboard.stripe.com/test/apikeys
# Webhook secret: `stripe listen --forward-to localhost:3000/api/payments/webhook`
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""


# ─── 🇮🇳 Razorpay (OPTIONAL — for INR payments) ────────────────────────
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""


# ─── 🗺️  Google Maps (OPTIONAL — Leaflet + OSM works without this) ────
# https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=""


# ─── 📧 SMTP (OPTIONAL — booking emails) ───────────────────────────────
SMTP_HOST=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="SwiftCab <hello@swiftcab.com>"
