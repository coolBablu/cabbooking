# ─── Core ────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Database (Postgres) ─────────────────────────────────────────────
# Example local docker:
#   docker run -d --name swiftcab-pg -p 5432:5432 \
#     -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=swiftcab postgres:16
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/swiftcab?schema=public"

# ─── Auth ────────────────────────────────────────────────────────────
# 32+ character random secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_ISSUER="swiftcab"

# ─── Stripe ──────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ─── Razorpay (optional) ─────────────────────────────────────────────
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# ─── Google Maps ─────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=""

# ─── Email (SMTP) ────────────────────────────────────────────────────
SMTP_HOST=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="SwiftCab <hello@swiftcab.com>"
